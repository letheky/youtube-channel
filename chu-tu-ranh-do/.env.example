# Chỉ VSP TTS; không cần khóa ElevenLabs.
VSP_API_KEY=
VSP_BASE_URL=https://vsp-translator.duckdns.org:9045
# Nam miền Nam, phong cách kể chuyện; đề xuất, cần nghe mẫu trước sản xuất.
VSP_VOICE_ID=vi-thai-son
VSP_MODEL=vieneu-v3-turbo
# Căn lời cục bộ; lần đầu tải model small nếu chưa có cache.
VSP_ALIGN_MODEL=small
VSP_ALIGN_MODEL_DIR=
VSP_CHUNK_CHARS=180
# API luôn speed=1.0; chỉ đổi tốc độ một lần khi hậu kỳ.
TTS_SPEED=0.9
TTS_PAUSE=0.7
# Ánh xạ nhân vật -> ID VSP. Không tái sử dụng ID ElevenLabs từ kịch bản cũ.
VSP_VOICE_MAP_JSON={}
