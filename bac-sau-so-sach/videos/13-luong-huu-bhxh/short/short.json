 "segments": [
  {
   "scene": 8,
   "start": 0,
   "end": 6.167,
   "text": "Một trăm bốn chục triệu rút hôm nay chỉ bằng năm mươi tháng lương hưu hai triệu tám trăm ngàn."
  },
  {
   "scene": 5,
   "start": 6.417,
   "end": 15.583,
   "text": "Chọn bảy triệu thì mỗi tháng đóng một triệu năm trăm bốn chục ngàn. Năm năm là chín mươi hai triệu bốn trăm ngàn."
  },
  {
   "scene": 5,
   "start": 15.833,
   "end": 43.037,
   "text": "Vậy cái giá của đường giữ lại là: bỏ không rút một trăm bốn chục triệu, cộng chín mươi hai triệu bốn trăm ngàn đóng thêm, tổng hai trăm ba mươi hai triệu bốn trăm ngàn. Chia hai triệu tám trăm ngàn mỗi tháng, ra tám mươi ba tháng. Tám mươi ba tháng là sáu năm mười một tháng. Lãnh từ sáu mươi hai tuổi thì tới khoảng sáu mươi chín tuổi là hòa vốn."
  },
  {
   "scene": 8,
   "start": 43.287,
   "end": 47.564,
   "text": "Rút thì nhanh một lần. Để yên thì còn đường chọn."
  }
 ]
}