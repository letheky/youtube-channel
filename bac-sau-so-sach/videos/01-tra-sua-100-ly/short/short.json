 "segments": [
  {
   "scene": 1,
   "start": 0,
   "end": 10.582,
   "text": "Một trăm ly một ngày. Ba mươi lăm ngàn một ly. Vị chi ba triệu rưỡi một ngày, hơn một trăm triệu một tháng. Nghe sướng lỗ tai chưa?"
  },
  {
   "scene": 1,
   "start": 10.932,
   "end": 13.337,
   "text": "\"Khoan, đưa sổ đây Bác coi.\""
  },
  {
   "scene": 9,
   "start": 13.687,
   "end": 43.603,
   "text": "Doanh thu một trăm lẻ năm triệu. Trừ nguyên liệu bốn mươi mốt triệu. Trừ app mười triệu rưỡi. Trừ mặt bằng mười lăm triệu. Trừ nhân viên mười sáu triệu hai. Trừ điện nước, thuế, marketing, linh tinh mười một triệu rưỡi. Lời trên giấy mười triệu tám. Trừ khấu hao tám triệu ba. Còn lại: hai triệu năm trăm ngàn đồng."
  },
  {
   "scene": 1,
   "start": 43.953,
   "end": 47.513,
   "text": "Lời trên giấy chưa phải là lời trong túi."
  }
 ]
