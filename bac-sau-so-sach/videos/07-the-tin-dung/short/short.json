 "segments": [
  {
   "scene": 1,
   "start": 0,
   "end": 18.344,
   "text": "Con Út khoe với Bác, tháng rồi nó xài thẻ được hoàn một trăm ngàn. Tới hạn, nó cũng đã chuyển trả một triệu, đúng cái ô thanh toán tối thiểu. Vậy mà kỳ sau lại có tiền lãi. Nó hỏi, con trả đúng hạn rồi, ngân hàng còn thu gì nữa?"
  },
  {
   "scene": 1,
   "start": 18.594,
   "end": 24.732,
   "text": "Bác kéo cuốn sổ lại. Đúng hạn là một việc, trả đủ là một việc khác."
  },
  {
   "scene": 1,
   "start": 24.982,
   "end": 28.72,
   "text": "Út và mọi con số sắp tính là ví dụ giả định."
  },
  {
   "scene": 2,
   "start": 28.97,
   "end": 36.797,
   "text": "Khoản tối thiểu là yêu cầu của kỳ đó. Nó không hứa rằng mình chỉ cần trả chừng ấy là được miễn tiền lãi."
  },
  {
   "scene": 9,
   "start": 37.047,
   "end": 42.963,
   "text": "Tiền đang nằm trong tài khoản thanh toán chưa tự trở thành khoản trả nợ thẻ."
  },
  {
   "scene": 10,
   "start": 43.213,
   "end": 47.667,
   "text": "hạn mức là tiền được mượn, không phải tiền đã kiếm."
  }
 ]
}