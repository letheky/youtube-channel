 "segments": [
  {
   "scene": 1,
   "start": 0,
   "end": 4.849,
   "text": "giá vàng lên một triệu, mà sao em bán ra lại lỗ hết hai triệu vậy Bác?\""
  },
  {
   "scene": 1,
   "start": 5.029,
   "end": 7.655,
   "text": "\"Khoan, đưa sổ đây Bác coi.\""
  },
  {
   "scene": 3,
   "start": 7.835,
   "end": 16.017,
   "text": "Tuần trước chị mua. Chị mua thì chị trả theo cột bán ra: một trăm bốn mươi ba triệu sáu trăm ngàn."
  },
  {
   "scene": 3,
   "start": 16.197,
   "end": 23.401,
   "text": "Tuần này người ta nói giá vàng lên một triệu. Nghĩa là cả hai cột cùng nhích lên một triệu."
  },
  {
   "scene": 3,
   "start": 23.581,
   "end": 43.385,
   "text": "Chị đem vàng ra bán. Mà bán thì tiệm trả theo cột nào? Cột mua vào. Một trăm bốn mươi mốt triệu sáu. Mua một trăm bốn mươi ba triệu sáu, bán một trăm bốn mươi mốt triệu sáu. Lỗ hai triệu, dù giá vàng đã tăng một triệu thật."
  },
  {
   "scene": 11,
   "start": 43.565,
   "end": 46.503,
   "text": "Mua vàng thì nhìn cả giá bán lại."
  }
 ]
}