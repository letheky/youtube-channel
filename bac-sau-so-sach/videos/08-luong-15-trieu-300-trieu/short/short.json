 "segments": [
  {
   "scene": 1,
   "start": 0,
   "end": 12.744,
   "text": "Cậu Bảo qua nhà Bác, khoe mới lên lương mười lăm triệu. Nó tính gọn lắm: mỗi tháng xài mười triệu, cất năm triệu. Năm năm là ba trăm triệu, chưa kể tiền lãi."
  },
  {
   "scene": 1,
   "start": 12.994,
   "end": 18.154,
   "text": "Bảo và toàn bộ tiền sinh hoạt sắp kể là ví dụ giả định của Bác."
  },
  {
   "scene": 4,
   "start": 18.404,
   "end": 24.542,
   "text": "Hai chục bốn triệu chia mười hai, là hai triệu một tháng cần dành riêng cho chi trong năm."
  },
  {
   "scene": 4,
   "start": 24.792,
   "end": 30.041,
   "text": "giờ chỉ còn hai triệu năm trăm hai mươi lăm ngàn để góp cho mục tiêu dài hơn."
  },
  {
   "scene": 5,
   "start": 30.291,
   "end": 38.591,
   "text": "Giữ mức góp hai triệu năm trăm hai mươi lăm ngàn suốt sáu chục tháng, chưa tính lãi, là một trăm năm mươi mốt triệu rưỡi."
  },
  {
   "scene": 10,
   "start": 38.841,
   "end": 44.89,
   "text": "Tiền để dành là phần còn lại sau một năm thật, không phải sau một tháng đẹp trời."
  }
 ]
}