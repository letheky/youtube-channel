 "segments": [
  {
   "scene": 1,
   "start": 0,
   "end": 6.706,
   "text": "Quán cà phê chiều nào cũng kín mấy bàn ngoài cửa, mà cô Bảy lại hỏi Bác chuyện sang quán."
  },
  {
   "scene": 1,
   "start": 6.956,
   "end": 11.494,
   "text": "Cô Bảy trong câu chuyện gom bốn trăm hai mươi triệu để mở quán."
  },
  {
   "scene": 2,
   "start": 11.744,
   "end": 17.792,
   "text": "Ba khoản này cộng lại ba trăm triệu, là khoản mình muốn thu hồi từ việc vận hành quán."
  },
  {
   "scene": 8,
   "start": 18.042,
   "end": 35.113,
   "text": "Ví dụ cô Bảy chỉ có hai mươi bốn tháng thuê chắc chắn, giá hai chục triệu giữ nguyên trong thời hạn đó. Trong khi mô phỏng thu lại tiền làm quán cần ba mươi hai tháng. Tám tháng chênh ấy không tự biến thành quyền ở lại."
  },
  {
   "scene": 6,
   "start": 35.363,
   "end": 40.701,
   "text": "Điều kiện là còn được thuê tiếp cùng giá và quán giữ được dòng tiền đó."
  },
  {
   "scene": 10,
   "start": 40.951,
   "end": 45.05,
   "text": "Đừng chỉ đếm bàn kín. Hãy đếm tháng lấy lại tiền."
  }
 ]
}