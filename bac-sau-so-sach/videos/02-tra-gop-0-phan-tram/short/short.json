 "segments": [
  {
   "scene": 1,
   "start": 0,
   "end": 10.227,
   "text": "\"Bác Sáu ơi, cái máy này hai mươi ba triệu rưỡi, mà trả góp không phần trăm, mỗi tháng con chỉ trả có gần bốn triệu. Lãi không đồng, Bác thấy hời không?\""
  },
  {
   "scene": 1,
   "start": 10.427,
   "end": 13.098,
   "text": "\"Khoan, đưa sổ đây Bác coi.\""
  },
  {
   "scene": 4,
   "start": 13.298,
   "end": 43.658,
   "text": "Bây giờ so lại cho công bằng. Trả thẳng: hai mươi hai triệu bốn trăm chín chục ngàn. Trả góp không phần trăm: hai mươi ba triệu bốn trăm chín chục ngàn, cộng thêm gần chín trăm ngàn phí, là hai mươi bốn triệu ba trăm bảy mươi tám ngàn. Chênh nhau gần một triệu chín. Mà mình chỉ mượn tiền có sáu tháng. Quy ra lãi suất theo năm, nó tương đương gần hai mươi chín phần trăm một năm."
  },
  {
   "scene": 11,
   "start": 43.858,
   "end": 46.707,
   "text": "Ở đời không có gì là không đồng."
  }
 ]
}