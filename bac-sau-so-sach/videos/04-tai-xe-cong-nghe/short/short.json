 "segments": [
  {
   "scene": 1,
   "start": 0,
   "end": 9.032,
   "text": "hôm nay con chạy được hai mươi hai cuốc, khách trả tổng cộng sáu trăm sáu chục ngàn. Một tháng chạy hai mươi sáu ngày, là mười bảy triệu đó Bác."
  },
  {
   "scene": 1,
   "start": 9.532,
   "end": 11.847,
   "text": "\"Khoan, đưa sổ đây Bác coi.\""
  },
  {
   "scene": 7,
   "start": 12.347,
   "end": 30.907,
   "text": "Khách trả sáu trăm sáu chục ngàn. Ứng dụng giữ khoảng hai trăm năm chục ngàn. Cây xăng lấy một trăm lẻ tám ngàn. Chiếc xe ăn ba mươi bảy ngàn. Lặt vặt ba chục ngàn. Còn lại: khoảng hai trăm ba mươi lăm ngàn đồng."
  },
  {
   "scene": 10,
   "start": 31.407,
   "end": 36.923,
   "text": "\"Vậy là con chạy mười hai tiếng, mà mỗi giờ còn chưa tới hai chục ngàn hả Bác.\""
  },
  {
   "scene": 10,
   "start": 37.423,
   "end": 43.122,
   "text": "Màn hình hiện doanh thu, cuốn sổ mới hiện thu nhập. Chào bà con nghen."
  }
 ]
}