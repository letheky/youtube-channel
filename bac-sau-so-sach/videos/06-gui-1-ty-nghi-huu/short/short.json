 "segments": [
  {
   "scene": 1,
   "start": 0,
   "end": 5.456,
   "text": "Giả sử gửi một tỷ, bình quân mỗi tháng có bốn triệu rưỡi tiền lãi."
  },
  {
   "scene": 5,
   "start": 5.706,
   "end": 14.911,
   "text": "Nếu giá tăng bốn phần trăm thì cuối năm phải có một tỷ không trăm bốn chục triệu mới mua được lượng hàng ngang một tỷ đầu năm."
  },
  {
   "scene": 5,
   "start": 15.161,
   "end": 27.655,
   "text": "Nghĩa là cần giữ lại bốn chục triệu để bù sức mua của vốn. Lãi năm mươi bốn triệu, giữ lại bốn chục, còn mười bốn triệu có thể đem chi trong phép thử này."
  },
  {
   "scene": 5,
   "start": 27.905,
   "end": 41.865,
   "text": "Chia đều thì khoảng một triệu một trăm bảy chục ngàn một tháng, tính bằng tiền danh nghĩa ở cuối năm. Con số đó khác xa bốn triệu rưỡi ban đầu vì mình vừa đặt thêm yêu cầu giữ sức mua của gốc."
  },
  {
   "scene": 10,
   "start": 42.115,
   "end": 45.858,
   "text": "Tiền đủ nghỉ bao lâu, phải tính bằng sức mua."
  }
 ]
}