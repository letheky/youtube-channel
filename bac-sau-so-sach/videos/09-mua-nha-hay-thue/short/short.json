 "segments": [
  {
   "scene": 1,
   "start": 0,
   "end": 4.3,
   "text": "Hiếu nói mỗi tháng trả chín triệu tiền thuê là mất trắng."
  },
  {
   "scene": 1,
   "start": 4.65,
   "end": 9.81,
   "text": "Cùng tiền ban đầu, cùng khoản dành cho nhà ở và tích lũy mỗi tháng."
  },
  {
   "scene": 1,
   "start": 10.16,
   "end": 16.653,
   "text": "Đây là chuyện giả định của Hiếu với Thảo, không phải giá nhà bình quân hay lời rủ mua bán."
  },
  {
   "scene": 4,
   "start": 17.003,
   "end": 20.474,
   "text": "Cả hai đều được để dành, vậy mới công bằng."
  },
  {
   "scene": 7,
   "start": 20.824,
   "end": 38.25,
   "text": "Bác đổi riêng tăng giá nhà thành năm phần trăm mỗi năm, giữ nguyên mọi thứ khác. Vẫn gói thanh lý ba phần trăm, vẫn tài khoản tích lũy bên mua như cũ. Tổng phía mua lúc này khoảng mười tỷ ba trăm chín chục triệu, vượt phía thuê."
  },
  {
   "scene": 10,
   "start": 38.6,
   "end": 44.743,
   "text": "Mua hay thuê, đừng so mỗi tiền nhà; hãy so cả đường đi của tiền."
  }
 ]
}