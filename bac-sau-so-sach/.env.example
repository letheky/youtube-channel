# Sao chép file này thành .env rồi điền key. KHÔNG dán key vào chat, KHÔNG commit .env.

# OpenAI — tạo ảnh cảnh (platform.openai.com > API keys). Gói ChatGPT Plus không bao gồm API.
OPENAI_API_KEY=

# ElevenLabs — giọng đọc (elevenlabs.io > Developers > API Keys). Nên giới hạn quyền chỉ Text to Speech.
ELEVENLABS_API_KEY=
# Voice ID của giọng Bác Sáu (Voice Library > chọn giọng > Copy Voice ID)
ELEVENLABS_VOICE_ID=

# YouTube Data API dùng OAuth, không dùng API key:
# tải file OAuth Client (Desktop app) từ Google Cloud Console, đặt tên client_secret.json ở thư mục gốc.

# --- Tùy chọn (để trống thì dùng mặc định trong script) ---
# ELEVENLABS_MODEL_ID=eleven_v4          # eleven_v3 nếu muốn thử bản cũ (giới hạn 5.000 ký tự/cảnh)
# ELEVENLABS_SPEED=0.9                  # 0.7–1.2; 1.0 = tốc độ gốc
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# OPENAI_IMAGE_QUALITY=medium            # low | medium | high — high đắt hơn nhiều
# ELEVENLABS_CREDIT_PER_CHAR=1.0              # đo thực tế eleven_v4 ~0.44; đặt 0.5 khi đã xác nhận ở tab Usage
# ELEVENLABS_CANH_BAO=20000                  # in cảnh báo khi credit còn dưới mức này
